# =============================================================================
# EBB ATM OPERATIONS INTELLIGENCE — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security.
# Must never be prefixed with NEXT_PUBLIC_ and never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used by the Documents module.
SUPABASE_STORAGE_BUCKET=ebb-documents

# -----------------------------------------------------------------------------
# AI (not connected in this phase — placeholders only)
# -----------------------------------------------------------------------------
# One of: mock | anthropic | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=EBB ATM Operations Intelligence
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When Supabase is not configured the app boots in read-only DEMO MODE using
# synthetic in-memory data. Set to "false" to hard-fail instead of falling back.
NEXT_PUBLIC_ALLOW_DEMO_MODE=true
